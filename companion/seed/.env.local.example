# Copy to the repo root as .env.local (never commit .env.local).

# One provider key. Environment keys always win over keys saved in Settings.
ANTHROPIC_API_KEY=
# or: OPENROUTER_API_KEY=

# Which engine runs sessions. Leave unset: learnharness once you connect your AI in /app (ChatGPT
# or a key, with all three model slots set), scripted (authored questions, no key) until then.
# Set it only to force one engine, e.g. COMPANION_ENGINE=scripted for a no-AI demo.
# COMPANION_ENGINE=learnharness
# 1 = if LearnHarness fails to produce question 1, retry the session on the scripted engine (logged as engine_fallback).
COMPANION_AUTO_FALLBACK=0
# 1 = enables /api/companion/demo/* (facilitator), materials upload and the CSV export.
# Leave it 0 for everyday use; set it to 1 only on a facilitator laptop for a user test.
COMPANION_DEMO=0
# Question-1 timeout for session preparation.
# COMPANION_READY_TIMEOUT_MS=60000

# Optional: fill the model slots at seed time ("provider/model-id", from LearnHarness's catalogue).
# COMPANION_MODEL_STRONG=anthropic/<model-id>
# COMPANION_MODEL_CHEAP=anthropic/<model-id>
# COMPANION_MODEL_VISION=anthropic/<model-id>

# No DEEPGRAM_API_KEY: dictation stays off.
